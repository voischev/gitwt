{
  "name": "gitwt",
  "version": "0.1.0",
  "description": "Agent-independent Git worktree manager with a CLI and Node.js API",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "git-wt": "./bin/git-wt.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "check": "biome check .",
    "test": "node --test",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voischev/gitwt.git"
  },
  "homepage": "https://github.com/voischev/gitwt",
  "bugs": {
    "url": "https://github.com/voischev/gitwt/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "git",
    "worktree",
    "cli"
  ],
  "license": "MIT"
}
